{{!
    @template local_trustgrade/question_new_item

    New question item as table rows (tbody).

    Context variables required for this template:
    * index - Question index
    * cmid - Course module ID
    * questionNumber - Display number for question
    * editFormHtml - Rendered edit form HTML
}}
<tbody class="editable-question-item" data-question-index="{{index}}" data-cmid="{{cmid}}" data-question-id="0">
    <tr class="question-display-mode">
        <td class="col-no">{{questionNumber}}</td>
        <td class="col-question">
            <div class="question-content">
                <p class="mb-1"><strong>{{#str}}question, local_trustgrade{{/str}}:</strong> <em>{{#str}}click_edit_add_question, local_trustgrade{{/str}}</em></p>
                <div class="mt-2">
                    <p class="mb-1"><strong>{{#str}}options, local_trustgrade{{/str}}:</strong></p>
                    <ul class="mb-0"><li class="mb-1"><em>{{#str}}click_edit_add_options, local_trustgrade{{/str}}</em></li></ul>
                </div>
            </div>
        </td>
        <td class="col-blooms">–</td>
        <td class="col-mandatory">
            <div class="d-flex align-items-center gap-2 mandatory-controls" data-question-dbid="0">
                <button type="button" class="btn btn-sm btn-outline-primary toggle-mandatory-btn" data-mandatory="0" data-question-id="0" title="{{#str}}make_mandatory, local_trustgrade{{/str}}">
                    <i class="fa fa-star" aria-hidden="true"></i> {{#str}}make_mandatory, local_trustgrade{{/str}}
                </button>
            </div>
        </td>
        <td class="col-actions">
            <div class="question-controls d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary edit-question-btn">
                    <i class="fa fa-edit" aria-hidden="true"></i> {{#str}}edit, local_trustgrade{{/str}}
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger delete-question-btn">
                    <i class="fa fa-trash" aria-hidden="true"></i> {{#str}}delete, local_trustgrade{{/str}}
                </button>
            </div>
        </td>
    </tr>
    <tr class="question-edit-mode" style="display: none;">
        <td colspan="5" class="p-4 bg-light">
            {{{editFormHtml}}}
        </td>
    </tr>
</tbody>
