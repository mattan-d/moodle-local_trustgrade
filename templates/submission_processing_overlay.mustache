{{!
    @template local_trustgrade/submission_processing_overlay

    Template for the submission processing overlay that appears when students submit assignments.

    Context variables:
    * title - The title text for the processing overlay
    * message - The message text explaining what is happening
    * spinner_class - CSS class for the spinner icon

    @package    local_trustgrade
    @copyright  2025 CentricApp LTD <support@centricapp.co.il>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div id="submission-processing-overlay" class="local-trustgrade submission-processing-overlay">
    <div class="processing-modal">
        <div class="spinner-container">
            <i class="{{spinner_class}}" aria-hidden="true"></i>
        </div>
        <h3 class="processing-title">{{title}}</h3>
        <p class="processing-message">{{message}}</p>
    </div>
</div>
